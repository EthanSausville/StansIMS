{
  // Cloudflare Worker that serves the site in ./public.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "stansims",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /config.js is generated by the Worker from the SUPABASE_* variables, and
    // /api/* (user management for admins) is handled by the Worker.
    "run_worker_first": ["/config.js", "/api/*"]
  },
  // Supabase project URL and publishable key. Both are public by design: the
  // data is protected by sign-in and row-level security. Never put the secret
  // (service_role) key here.
  "vars": {
    "SUPABASE_URL": "https://mwzylzmhktmpnrodtaoo.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_V1sS1HvuyrixOA28RfpnLA_2VcGWJYk"
  },
  // Keep any other variables set in the dashboard when this file is deployed.
  "keep_vars": true,
  "observability": { "enabled": true }
}
