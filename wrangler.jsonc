{
  // Cloudflare Worker that serves the site in ./public.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "stansims",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /config.js is generated by the Worker from the SUPABASE_* variables.
    "run_worker_first": ["/config.js"]
  },
  // Keep the variables set in the dashboard (Settings -> Variables and Secrets)
  // when this file is deployed.
  "keep_vars": true,
  "observability": { "enabled": true }
}
